{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brise",
  "version": "1.0.4",
  "identifier": "de.brise.wetter",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Brise — Wetter für Deutschland",
        "width": 1440,
        "height": 920,
        "minWidth": 640,
        "minHeight": 480,
        "center": false,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#081018"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/icon.png"
    ],
    "category": "Weather",
    "shortDescription": "Moderne DWD-Wetter-App für deutsche Städte",
    "longDescription": "Brise zeigt aktuelle DWD-Wetterdaten, Vorhersagen, Warnungen, Regenradar und einen deutschlandweiten Städtevergleich — gestochen scharf und für Wayland gebaut.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  },
  "plugins": {}
}
