#!/usr/bin/env bash
# Brise-Launcher für Hyprland: öffnet das Fenster geteilt auf dem Monitor,
# auf dem sich der Mauszeiger gerade befindet. Die genaue Position bestimmt
# das Hyprland-Layout. Mit BRISE_MONITOR kann ein Monitor vorgegeben werden.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="${BRISE_BIN:-$here/brise}"

if command -v hyprctl >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
  cursor="$(hyprctl cursorpos -j 2>/dev/null || true)"
  if command -v jq >/dev/null 2>&1 && [ -n "$cursor" ]; then
    cx="$(jq -r '.x // empty' <<<"$cursor")"
    cy="$(jq -r '.y // empty' <<<"$cursor")"
    if [ -n "$cx" ] && [ -n "$cy" ]; then
      target="$(hyprctl monitors -j 2>/dev/null | jq -r --argjson x "$cx" --argjson y "$cy" '
        [.[] | select(.x <= $x and $x < .x + .width and .y <= $y and $y < .y + .height)] | first | .name // empty' || true)"
    fi
  fi

  if [ -z "${target:-}" ]; then
    cursor_plain="$(hyprctl cursorpos 2>/dev/null || true)"
    cx="${cx:-${cursor_plain%%,*}}"
    cy="${cy:-${cursor_plain#*,}}"
    target="$(hyprctl monitors 2>/dev/null | awk -v px="${cx:-0}" -v py="${cy:-0}" '
      /^Monitor / { name = $2 }
      /^[[:space:]]*[0-9]+x[0-9]+@[^ ]+ at / {
        dims = $1
        sub(/@.*/, "", dims)
        split(dims, d, "x")
        split($3, p, "x")
        if (px >= p[1] && px < p[1] + d[1] && py >= p[2] && py < p[2] + d[2]) { print name; exit }
      }' || true)"
  fi
fi

MONITOR="${BRISE_MONITOR:-${target:-}}"

# Die echte Monitorfrequenz benötigt der Vblank-Shim, damit WebKit auf 180-Hz-
# Displays nicht auf den 60-Hz-Timer zurückfällt. Immer Aufrunden auf Hz.
if [ -n "$MONITOR" ] && command -v hyprctl >/dev/null 2>&1; then
  refresh="$(hyprctl monitors -j 2>/dev/null | jq -r --arg m "$MONITOR" \
    '[.[] | select(.name == $m) | .refreshRate] | first // empty' 2>/dev/null || true)"
  if [ -z "$refresh" ] || [ "$refresh" = null ]; then
    refresh="$(hyprctl monitors 2>/dev/null | awk -v m="$MONITOR" '
      /^Monitor / { name = $2 }
      /^[[:space:]]*[0-9]+x[0-9]+@/ {
        split($1, mode, "@")
        if (name == m) { print mode[2]; exit }
      }' 2>/dev/null || true)"
  fi
  case "$refresh" in
    ''|*[!0-9.]*) ;;
    *) BRISE_REFRESH_HZ="$(printf '%.0f' "$refresh")"; export BRISE_REFRESH_HZ ;;
  esac
fi

# Die Regel wird vor dem Start registriert, damit das Fenster nicht kurz
# auf dem falschen Monitor auftaucht. Alte Regeln früherer Versionen
# deaktivieren wir zuerst, damit sich die Effekte nicht überlagern.
if command -v hyprctl >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && [ -n "$MONITOR" ]; then
  hyprctl eval '
    if _G.briseCursorRule then _G.briseCursorRule:set_enabled(false) end;
    local old = hl.window_rule({name="brise-secondary"});
    if old then old:set_enabled(false) end;
    _G.briseCursorRule = hl.window_rule({
      name="brise-cursor",
      match={class="brise"},
      tile=true,
      monitor="'"$MONITOR"'",
      animation="popin 80%"
    })' >/dev/null 2>&1 || true
fi

# Native Wayland-Darstellung: WebKitGTK zeichnet dort schärfer und der
# Compositor behält die Kontrolle über die Platzierung.
if [ "${XDG_SESSION_TYPE:-}" = "wayland" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
  export GDK_BACKEND=wayland
fi

# OpenGL bleibt aktiv, damit WebKit auf der GPU komponiert. Die GTK3-Frame-
# Clock bekommt die Monitorfrequenz direkt in Rust gesetzt (sonst 60 Hz).
export GDK_GL="${BRISE_GDK_GL:-always}"

# NVIDIA liefert drmWaitVBlank EOPNOTSUPP. Der Shim ersetzt genau diesen
# Fehler durch einen echten Vblank mit BRISE_REFRESH_HZ; auf Treibern, die
# Vblank selbst können, verändert er nichts.
shim="${BRISE_VBLANK_LIB:-$here/libbrise-vblank.so}"
if [ ! -f "$shim" ] && [ -f /usr/lib/brise/libbrise-vblank.so ]; then
  shim=/usr/lib/brise/libbrise-vblank.so
fi
if [ -f "$shim" ]; then
  export LD_PRELOAD="$shim${LD_PRELOAD:+:$LD_PRELOAD}"
else
  echo "Hinweis: Vblank-Shim fehlt – hohes Scroll-Tempo ist nicht verfügbar." >&2
fi

# Keine künstlichen Frame-Limits und kein erzwungenes Timer-Vblank: WebKit
# soll sich am Vblank des Monitors ausrichten. Der NVIDIA-Sync-Flag wird
# bewusst entfernt: Er erzeugt auf dem 180-Hz-Monitor sichtbares Ruckeln.
unset WEBKIT_DISPLAY_REFRESH_THROTTLE_FPS
unset WEBKIT_FORCE_VBLANK_TIMER
unset WEBKIT_DISABLE_COMPOSITING_MODE
unset __NV_DISABLE_EXPLICIT_SYNC

if [ -n "$MONITOR" ]; then
  export BRISE_MONITOR="$MONITOR"
fi

exec "$BIN" "$@"
